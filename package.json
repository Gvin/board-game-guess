{
  "name": "board-game-guess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply board-game-guess --local",
    "db:migrate": "wrangler d1 migrations apply board-game-guess --remote",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.42.0"
  }
}
